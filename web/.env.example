# Where the Django backend is. Copy this file to .env.local and change it if the backend is elsewhere.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional: "Continue with Google". The web OAuth client ID from Google Cloud Console (not a secret).
# Add http://localhost:3000 to its "Authorised JavaScript origins", and list the same ID in the
# backend's GOOGLE_CLIENT_IDS. Leave empty to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
