# Copy this file to `.env` (git-ignored) and fill it in.
# `scripts\create-db.ps1` does it for you: it creates the database and writes a .env with generated secrets.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# 1 for local development, 0 in production
DJANGO_DEBUG=1
# Comma-separated host names this server may answer to ("*" is fine for local development only)
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL
DB_NAME=mzazicare
DB_USER=mzazicare
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# ---- Sign-in codes by email (two-step sign-in for accounts created from now on) ----
# Sign-in codes. Recommended: Azure Communication Services Email (no personal mailbox needed). Paste the
# connection string of the Communication Service and set EMAIL_FROM to its DoNotReply@...azurecomm.net address.
ACS_EMAIL_CONNECTION_STRING=
# Or any SMTP server. Leave both empty in development: the codes are then printed in the backend console.
# Gmail example: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=you@gmail.com, EMAIL_HOST_PASSWORD=<an app password>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_FROM=MzaziCare <no-reply@mzazicare.local>
# Development only: also return the code in the API response (for ml/voice/test_endpoint.py).
# Ignored unless DJANGO_DEBUG=1 and EMAIL_HOST is empty.
MZAZI_2FA_ECHO_CODE=0

# ---- Sign in with Google (optional) ----
# OAuth client IDs from Google Cloud Console (web, Android, iOS), comma-separated. Empty = Google sign-in is off.
GOOGLE_CLIENT_IDS=

# ---- Push notifications (optional) ----
# Path to the Firebase service-account key (Firebase console > Project settings > Service accounts).
# Keep the file OUTSIDE the project, e.g. %LOCALAPPDATA%\mzazicare-deploy\firebase-service-account.json.
# Empty = no notifications are sent. On Azure the deploy script sets FIREBASE_CREDENTIALS_B64 instead.
FIREBASE_CREDENTIALS_FILE=
