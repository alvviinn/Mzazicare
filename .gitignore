# ---- Secrets and local configuration: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
*.sqlite3
.pytest_cache/
.coverage
htmlcov/

# ---- Node / Expo (also covered in mobile/.gitignore) ----
node_modules/
.expo/
dist/
dist-check/
web-build/

# ---- Machine learning: data and large intermediates stay out of Git ----
# Datasets are downloaded to MZAZI_DATA (default C:\mzazicare-data\voice), outside the repository.
*.npz
*.tar.gz
*.zip
*.wav
*.flac
# the trained model files in ml/voice/artifacts ARE tracked on purpose (about 1 MB)

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
