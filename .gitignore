# ---- Secrets and local configuration: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
*.sqlite3
.pytest_cache/
.coverage
htmlcov/

# ---- Node / Expo (also covered in mobile/.gitignore) ----
node_modules/
.expo/
dist/
dist-check/
web-build/

# ---- Machine learning: data and large intermediates stay out of Git ----
# Datasets are downloaded to MZAZI_DATA (default C:\mzazicare-data\voice), outside the repository.
*.npz
*.tar.gz
*.zip
*.wav
*.flac
# the trained model files in ml/voice/artifacts ARE tracked on purpose (about 1 MB)

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# Django collectstatic output (production)
backend/staticfiles/

# first-aid model: 118 MB, over GitHub's 100 MB limit. Kept on disk (scripts/deploy-azure.ps1 copies it) and backed up
# in C:/mzazicare-data/firstaid/models. The word models (*.npz, ignored above) live there too.
ml/firstaid/artifacts/intent.onnx

# ---- Firebase (push notifications): keep these out of Git. They live in %LOCALAPPDATA%\mzazicare-deploy ----
google-services.json
GoogleService-Info.plist
*firebase-adminsdk*.json
firebase-service-account*.json
*service-account*.json
