@startuml fig4_11_activity
!include style.iuml
skinparam ranksep 30

|Caregiver phone|
start
:Sign in (CaretakerHome opens);
:Share location every 15 s\n(also in the background);
|Django API|
repeat
  :Compare caregiver and elderly phones\n(fresh, accurate, not mocked);
repeat while (Within 15 m?) is (no: show distance)
->yes;
:Start today's Shift and open a segment;
fork
  |Caregiver phone|
  :Tick a task and take a proof photo;
  |Django API|
  if (Still within 15 m?) then (yes)
    :Save TaskCompletion with photo;
  else (no)
    :Refuse with 403;
  endif
fork again
  |Caregiver phone|
  :Record a 10 s clip\n(if both people agreed);
  |Django API|
  :Analyse in memory, keep tone shares,\ndiscard the audio;
  if (3+ windows >= 60 % angry?) then (yes)
    :Create vocal_distress Alert;
    |Family|
    :Get a push notification;
    :Confirm or dismiss the alert;
  else (no)
  endif
fork again
  |Django API|
  if (Beyond 20 m?) then (yes)
    :Close the segment (break);
    :Open a new segment on return;
  else (no)
  endif
end fork
|Django API|
:Close the shift\n(End tapped, or midnight);
|Family|
:Review the day: timeline, breaks,\ntask photos, voice tone;
stop
@enduml
