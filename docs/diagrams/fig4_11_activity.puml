@startuml fig4_11_activity
!include style.iuml
skinparam defaultFontSize 13
skinparam ActivityFontSize 13
skinparam ActivityDiamondFontSize 13
skinparam ArrowFontSize 12

start
:Caregiver signs in (CaretakerHome);
:Phones share location every 15 s;
repeat
  :API compares the two phones\n(fresh, accurate, not mocked);
repeat while (Within 15 m of the\nelderly phone?) is (no: show distance)
->yes;
:API starts today's Shift\nand opens a segment;
fork
  :Caregiver ticks a task\nand takes a photo;
  if (Still within 15 m?) then (yes)
    :Save TaskCompletion\nwith the photo;
  else (no)
    :Refuse (403);
  endif
fork again
  :Phone sends a 10 s clip\n(both people agreed);
  :Analyse in memory,\nkeep tone shares only;
  if (3+ windows\n>= 60 % angry?) then (yes)
    :vocal_distress Alert;\npush to the family;
  else (no)
  endif
fork again
  if (Beyond 20 m?) then (yes)
    :Break: close the segment;
    :Back within 15 m:\nnew segment, same shift;
  else (no)
  endif
end fork
:Shift closes\n(End tapped, or midnight);
:Family reviews the day: timeline,\nbreaks, task photos, tone,\nand confirms or dismisses alerts;
stop
@enduml
