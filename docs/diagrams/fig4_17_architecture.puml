@startuml fig4_17_architecture
!pragma layout smetana
!include style.iuml
left to right direction
skinparam ranksep 70
skinparam nodesep 18

package "Presentation tier" {
  component "Mobile app\nReact Native + Expo (TypeScript)\nfamily · caregiver · elderly" as App
  component "Family web dashboard\nNext.js (static export)" as Web
}

package "Application tier: Django REST Framework API" {
  component "REST endpoints\naccounts: JWT, two-step code, Google sign-in, roles\ncare: shifts, tasks, alerts, chat, medicines, check-ins" as Api
  component "Geofence engine\n(presence.py)" as Geo
  component "Tone model\n(ONNX Runtime, in memory)" as Tone
  component "First-aid assistant\n(multilingual-e5-small + guide)" as FA
}

database "PostgreSQL\n(data tier)" as DB

component "Google Sign-In" as G
component "Azure Communication\nServices Email" as Mail
component "Firebase Cloud\nMessaging" as FCM

App --> Api : HTTPS, JSON, JWT
Web --> Api : HTTPS, JSON, JWT
Api --> Geo
Api --> Tone
Api --> FA
Api --> DB : Django ORM
Api --> G : verify ID token
Api --> Mail : sign-in code
Api --> FCM : alerts, messages
@enduml
