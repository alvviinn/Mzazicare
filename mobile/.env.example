# Copy this file to `.env.local` (git-ignored). `scripts\run-mobile.ps1` creates it for you.
#
# Address of the MzaziCare backend as the PHONE sees it:
#   physical phone on the same Wi-Fi  ->  http://<your PC's Wi-Fi IP>:8000   (find it with `ipconfig`)
#   Android emulator                   ->  http://10.0.2.2:8000
#
# Warning: every EXPO_PUBLIC_* value is bundled into the app and readable by anyone who has it.
# Never put passwords or API keys here.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000

# Optional: "Continue with Google". OAuth client IDs from Google Cloud Console (these are not secrets).
# Leave them empty and the Google button is hidden. Google sign-in needs a development build of the app
# (npx expo run:android), not Expo Go, and the same IDs listed in the backend's GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
